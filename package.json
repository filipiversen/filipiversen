{
  "name": "filipiversen",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "description": "Personal portfolio at filipiversen.com — SolidStart with prerendered content, deployed to Vercel.",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/generate-public-content.mjs && node scripts/generate-sitemap.mjs && vite build && node scripts/check-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:build": "node scripts/check-build.mjs",
    "content:generate": "node scripts/generate-public-content.mjs",
    "test:content": "node --test scripts/mdx-to-markdown.test.mjs"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.2.7",
    "@fontsource/geist-sans": "^5.2.5",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.0.0",
    "nitro": "^3.0.260610-beta",
    "solid-js": "^1.9.12",
    "solid-mdx": "^0.0.7"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^22.10.0",
    "gray-matter": "^4.0.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.7.2",
    "vite": "^8.2.1",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-mdx": "^3.1.1",
    "mdast-util-to-markdown": "^2.1.2"
  },
  "engines": {
    "node": ">=24"
  }
}
